# ─── Django ──────────────────────────────────────────────────────────────────
# SECURITY WARNING: replace with a long random string in production
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (no extra config needed)
# Uncomment and fill in for PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=cropx
# DB_USER=cropx_user
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@cropx.local
# Production SMTP example (SendGrid):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# EMAIL_USE_TLS=True

# ─── CORS ─────────────────────────────────────────────────────────────────────
# In production, list your exact frontend origins:
# CORS_ALLOWED_ORIGINS=https://app.cropx.io
